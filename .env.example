# Copy to .env.local and fill in your Supabase project values.
# Never commit .env or .env.local — they are gitignored.

# Main Supabase project (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: separate Supabase project for authentication
VITE_SUPABASE_NEED_AUTH_URL=
VITE_SUPABASE_NEED_AUTH_ANON_KEY=

# Security notes:
# - VITE_* variables are embedded in the client bundle. Only use the anon (public) key.
# - NEVER put the service_role key in a VITE_* variable or frontend code.
# - Protect sensitive data with Supabase Row Level Security (RLS) policies.
