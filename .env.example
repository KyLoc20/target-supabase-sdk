# Copy to .env.local and fill in your Supabase project values.
# Never commit .env or .env.local — they are gitignored.

# Main Supabase project (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: separate Supabase project for authentication
SUPABASE_NEED_AUTH_URL=
SUPABASE_NEED_AUTH_ANON_KEY=

# Security notes:
# - Use only the anon (public) key in app / worker env — protect data with RLS.
# - NEVER put the service_role key in env files consumed by client or worker scripts.
# - Vite frontends may expose vars via import.meta.env; pick a prefix policy in vite.config (e.g. VITE_).

# Logging (optional — L3 services via runServicePreload Phase 3½)
# Default when unset: DEBUG in dev, INFO when NODE_ENV=production (or service defaultLogMinLevel).
# Override: DEBUG | INFO | SUCCESS | WARN | ERROR | CRITICAL
# LOG_MIN_LEVEL=WARN

# Log persistence (optional — L3 services)
# LOG_PERSIST_ENABLED=true
# LOG_PERSIST_SERVICE=your-service-value
