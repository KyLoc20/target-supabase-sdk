{
    "name": "target-supabase-sdk",
    "version": "0.2.4",
    "description": "Supabase client initializer and data access APIs",
    "license": "MIT",
    "author": "KyLoc20",
    "homepage": "https://github.com/KyLoc20/target-supabase-sdk#readme",
    "bugs": {
        "url": "https://github.com/KyLoc20/target-supabase-sdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KyLoc20/target-supabase-sdk.git"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@9.15.0",
    "types": "./dist/browser.d.ts",
    "exports": {
        ".": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js",
            "default": "./dist/browser.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "import": "./dist/browser.js",
            "default": "./dist/browser.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js",
            "default": "./dist/node.js"
        },
        "./preload": {
            "types": "./dist/preload.d.ts",
            "import": "./dist/preload.js",
            "default": "./dist/preload.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
        "build": "pnpm clean && rollup -c && node --input-type=module -e \"console.log('[build] emitting declarations (tsc)...')\" && tsc -p tsconfig.dts.json && node scripts/verify-browser-entry.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "typecheck:scripts": "tsc -p tsconfig.scripts.json",
        "format": "biome check --write .",
        "format:check": "biome ci",
        "lint": "biome lint .",
        "worker:trigger": "tsx scripts/run-trigger-node.ts",
        "post-command": "tsx scripts/post-command.ts",
        "post-trigger": "tsx scripts/post-trigger.ts",
        "seed:system-registry": "tsx scripts/seed-system-registry.ts",
        "reset:system-registry": "tsx scripts/reset-system-registry.ts",
        "parcel:split": "tsx scripts/parcel-split-local.ts",
        "parcel:restore": "tsx scripts/parcel-restore-local.ts",
        "dev": "rollup -c --watch",
        "pack:check": "npm pack --dry-run",
        "prepack": "pnpm build"
    },
    "peerDependencies": {
        "@supabase/postgrest-js": "^1.19.0",
        "@supabase/supabase-js": "^2.50.0",
        "lodash-es": "^4.17.21",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-typescript": "^12.1.4",
        "@supabase/postgrest-js": "1.19.4",
        "@supabase/supabase-js": "2.50.3",
        "@types/lodash-es": "^4.17.12",
        "@types/wicg-file-system-access": "^2023.10.7",
        "lodash-es": "^4.17.21",
        "rollup": "^4.40.2",
        "tslib": "^2.8.1",
        "tsx": "^4.19.4",
        "typescript": "~5.7.2",
        "zod": "^3.24.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
