{
  "name": "target-supabase-sdk",
  "version": "0.2.0",
  "description": "Supabase client initializer and data access APIs",
  "license": "MIT",
  "author": "KyLoc20",
  "homepage": "https://github.com/KyLoc20/target-supabase-sdk#readme",
  "bugs": {
    "url": "https://github.com/KyLoc20/target-supabase-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyLoc20/target-supabase-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/verify-browser-entry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "worker": "tsx scripts/run-node-worker.ts",
    "worker:trigger": "tsx scripts/run-trigger-node.ts",
    "chrome-sidecar": "tsx scripts/chrome-sidecar-hub.ts",
    "post-task": "tsx scripts/post-task.ts",
    "post-command": "tsx scripts/post-command.ts",
    "post-trigger": "tsx scripts/post-trigger.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@supabase/postgrest-js": "^1.19.0",
    "@supabase/supabase-js": "^2.50.0",
    "lodash-es": "^4.17.21",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@supabase/postgrest-js": "1.19.4",
    "@supabase/supabase-js": "2.50.3",
    "@types/lodash-es": "^4.17.12",
    "@types/ws": "^8.18.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "lodash-es": "^4.17.21",
    "typescript": "~5.7.2",
    "tsx": "^4.19.4",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
