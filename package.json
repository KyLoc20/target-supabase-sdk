{
  "name": "target-supabase-sdk",
  "version": "0.1.8",
  "description": "Supabase client initializer and data access APIs",
  "license": "MIT",
  "author": "KyLoc20",
  "homepage": "https://github.com/KyLoc20/target-supabase-sdk#readme",
  "bugs": {
    "url": "https://github.com/KyLoc20/target-supabase-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyLoc20/target-supabase-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@supabase/postgrest-js": "^1.19.0",
    "@supabase/supabase-js": "^2.50.0",
    "lodash-es": "^4.17.21",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@supabase/postgrest-js": "1.19.4",
    "@supabase/supabase-js": "2.50.3",
    "@types/lodash-es": "^4.17.12",
    "@types/wicg-file-system-access": "^2023.10.7",
    "lodash-es": "^4.17.21",
    "typescript": "~5.7.2",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
